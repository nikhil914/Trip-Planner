# Required. Any long random string, for example from: openssl rand -base64 32
AUTH_SECRET=
# Optional. This email becomes the admin when it signs up. Without it, the first account is the admin.
ADMIN_EMAIL=

# Database. Leave empty to use a local SQLite file (local.db). Set both for Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=
OPENROUTER_MODEL_SECONDARY=
GOOGLE_PLACES_API_KEY=

# Optional. Base URL used in upload links and connector links, for example https://trips.example.com.
# Without it, the domain of the incoming request is used.
PUBLIC_URL=
